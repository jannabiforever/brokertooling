{
  "private": true,
  "scripts": {
    "start": "pnpm --filter @template/server start",
    "dev": "pnpm --filter @template/server dev",
    "dev:client": "pnpm --filter @template/client dev",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc && pnpm --filter @template/client typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "packageManager": "pnpm@12.9.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@effect/vitest": "catalog:",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.4",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
