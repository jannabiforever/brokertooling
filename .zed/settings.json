{
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": "prettier",
      "prettier": {
        "allowed": true,
        "plugins": ["@ianvs/prettier-plugin-sort-imports"]
      }
    }
  },
  "lsp": {
    "vtsls": {
      "binary": {
        "path": "node_modules/typescript/bin/tsc",
        "arguments": ["--lsp", "-stdio"]
      }
    }
  }
}
