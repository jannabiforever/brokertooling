{
  "name": "effect-v4",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "multiUser": false,
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  // the flake is the single toolchain definition; direnv loads it in every shell
  "postCreateCommand": "nix profile install nixpkgs#direnv && echo 'eval \"$(direnv hook bash)\"' >> ~/.bashrc && direnv allow && nix develop --command pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "mkhl.direnv",
        "oxc.oxc-vscode",
        "esbenp.prettier-vscode",
        "jnoortheen.nix-ide"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
